	name = Branton Boehm
	email = development@brantonboehm.com
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINz180vdbdbClag3rpZ/Lx8Reodt6QebvS86vcpBqLfP

[alias]
	graph = log --oneline --graph --decorate --branches
	shame = blame -w -M
[merge]
	conflictStyle = diff3
[fetch]
	prune = true
[pull]
	rebase = true
[push]
	default = upstream
	autoSetupRemote = true

[includeIf "hasconfig:remote.*.url:git@github.com:SiteBionics/**"]
	path = "config-sitebionics"
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[includeIf "hasconfig:remote.*.url:git@github-algo:*/**"]
	path = "config-algo"

[gpg]
	format = ssh

[gpg "ssh"]
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
    allowedSignersFile = "~/.ssh/allowed_signers"

[commit]
	gpgsign = true
